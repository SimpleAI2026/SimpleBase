# SimpleBase 环境变量配置模板
# 复制为 .env 并填入实际值；敏感字段必须从环境注入，禁止写入仓库。
# 所有变量前缀 SIMPLEBASE_，由 internal/config 加载。

# ── HTTP ──
SIMPLEBASE_HTTP_ADDRESS=:8080
SIMPLEBASE_HTTP_READ_TIMEOUT=15s
SIMPLEBASE_HTTP_WRITE_TIMEOUT=30s
SIMPLEBASE_HTTP_IDLE_TIMEOUT=60s

# ── Instance（必填）──
SIMPLEBASE_INSTANCE_ID=simplebase-dev-1
SIMPLEBASE_INSTANCE_WRITABLE=true

# ── Database（cache_dir 必填）──
SIMPLEBASE_DB_ENGINE=ducklake  # only ducklake; local/turso removed
SIMPLEBASE_DB_CACHE_DIR=.cache
SIMPLEBASE_DB_IDLE_TIMEOUT=5m
SIMPLEBASE_DB_MAX_OPEN=8
SIMPLEBASE_DB_MAX_IDLE=2

# ── DuckLake（用户库引擎，Phase 1 本地 DATA_PATH）──
SIMPLEBASE_DUCKLAKE_MEMORY_LIMIT=512MB
SIMPLEBASE_DUCKLAKE_THREADS=2
SIMPLEBASE_DUCKLAKE_EXTENSION_DIR=
SIMPLEBASE_DUCKLAKE_DATA_INLINING_ROW_LIMIT=100
SIMPLEBASE_DUCKLAKE_PARQUET_COMPRESSION=zstd
SIMPLEBASE_DUCKLAKE_TARGET_FILE_SIZE=64MB
SIMPLEBASE_DUCKLAKE_SYNC_MODE=debounce
SIMPLEBASE_DUCKLAKE_SYNC_DEBOUNCE_MS=200
SIMPLEBASE_DUCKLAKE_SYNC_KEEP_VERSIONS=10

# ── S3（writable 实例必填 bucket + region）──
SIMPLEBASE_S3_ENDPOINT=https://simplebase-1256235179.cos.ap-guangzhou.myqcloud.com
SIMPLEBASE_S3_REGION=ap-guangzhou
SIMPLEBASE_S3_BUCKET=simplebase-1256235179
SIMPLEBASE_S3_PREFIX=simplebase
SIMPLEBASE_S3_ACCESS_KEY=
SIMPLEBASE_S3_SECRET_KEY=
SIMPLEBASE_S3_FORCE_PATH_STYLE=true

# ── Catalog（历史字段；权威系统库见下）──
SIMPLEBASE_CATALOG_DATABASE_ID=simplebase-catalog

# ── System database（DuckLake 管控面）──
SIMPLEBASE_SYSTEM_DB_NAME=simplebase-system
SIMPLEBASE_SYSTEM_DB_HIDE_FROM_LIST=true
SIMPLEBASE_METRICS_FLUSH_INTERVAL=2s
SIMPLEBASE_LOG_FLUSH_INTERVAL=2s
SIMPLEBASE_LOG_KEEP_DAYS=14
SIMPLEBASE_DEV_MODE=false

# ── Auth（api_key_hash_secret 必填，32 字节随机）──
SIMPLEBASE_AUTH_APIKEY_SECRET=

# ── LLM（可选）──
# SIMPLEBASE_LLM_PROVIDERS=openai,anthropic
# SIMPLEBASE_LLM_PROVIDER_OPENAI_API_KEY=
# SIMPLEBASE_LLM_PROVIDER_OPENAI_BASE_URL=
# SIMPLEBASE_LLM_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Limits ──
SIMPLEBASE_LIMITS_MAX_REQUEST_BYTES=1048576
SIMPLEBASE_LIMITS_MAX_QUERY_ROWS=1000
SIMPLEBASE_LIMITS_QUERY_TIMEOUT=30s
SIMPLEBASE_LIMITS_MAX_CONCURRENT_QUERIES=64
SIMPLEBASE_LIMITS_MAX_BATCH_STATEMENTS=100
SIMPLEBASE_LIMITS_MAX_SQL_BYTES=65536

# ── Observability ──
SIMPLEBASE_LOG_LEVEL=info
SIMPLEBASE_LOG_FORMAT=json
SIMPLEBASE_METRICS_PATH=/metrics
