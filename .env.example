# SimpleBase 环境变量模板
# 复制为 .env（已被 gitignore）并填入实际值。
#
# 权威非密钥配置请写在 config.yaml（见 config.example.yaml）。
# 环境变量覆盖 YAML，用于：
#   - 引导路径 SIMPLEBASE_CONFIG_PATH
#   - 密钥注入（S3 / HMAC / LLM）
#   - 一次性覆盖（日志级别、监听地址等）
#
# 生产凭据禁止写入仓库。

# ── Bootstrap ──
# SIMPLEBASE_CONFIG_PATH=config.yaml

# ── Secrets（生产必填或改用 IAM 角色）──
SIMPLEBASE_S3_ACCESS_KEY=
SIMPLEBASE_S3_SECRET_KEY=
SIMPLEBASE_AUTH_APIKEY_SECRET=

# 可选 LLM 实例级密钥（运行时仍以 catalog CredentialRef 优先）
# SIMPLEBASE_LLM_PROVIDERS=openai
# SIMPLEBASE_LLM_PROVIDER_OPENAI_API_KEY=
# SIMPLEBASE_LLM_PROVIDER_OPENAI_BASE_URL=
# SIMPLEBASE_LLM_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o-mini
# SIMPLEBASE_LLM_PROVIDER_OPENAI_ALLOWED_MODELS=gpt-4o-mini,gpt-4o
# SIMPLEBASE_LLM_PROVIDER_OPENAI_TIMEOUT=60s

# ── 可选覆盖（优先改 yaml）──
# SIMPLEBASE_DEV_MODE=true
# SIMPLEBASE_LOG_LEVEL=debug
# SIMPLEBASE_LOG_FORMAT=console
# SIMPLEBASE_LOG_OUTPUT=stderr
# SIMPLEBASE_HTTP_ADDRESS=:8080
# SIMPLEBASE_INSTANCE_ID=simplebase-dev-1
# SIMPLEBASE_DB_CACHE_DIR=.cache
# SIMPLEBASE_S3_ENDPOINT=https://s3.example.com
# SIMPLEBASE_S3_REGION=ap-guangzhou
# SIMPLEBASE_S3_BUCKET=example-bucket
# SIMPLEBASE_S3_PREFIX=simplebase
# SIMPLEBASE_S3_FORCE_PATH_STYLE=true
# SIMPLEBASE_S3_KMS_KEY_ID=
# SIMPLEBASE_LLM_ENABLED=true
