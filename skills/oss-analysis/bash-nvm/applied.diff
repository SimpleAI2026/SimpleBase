     # shellcheck disable=SC2230
-    INFO="$(which "${COMMAND}") ($(type "${COMMAND}" | command awk '{ $1=$2=$3=$4=$5="" ;print }' | command sed 's/^\ *//g'))"
-  elif type "${COMMAND}" | nvm_grep -q "^${COMMAND} is /"; then
-    INFO="$(type "${COMMAND}" | command awk '{print $3}')"
+    INFO="$(which "${COMMAND}") ($(nvm_echo "${TYPE_INFO}" | command awk '{ $1=$2=$3=$4=$5="" ;print }' | command sed 's/^\ *//g'))"
+  elif nvm_echo "${TYPE_INFO}" | nvm_grep -q "^${COMMAND} is /"; then
+    INFO="$(nvm_echo "${TYPE_INFO}" | command awk '{print $3}')"
   else
-    INFO="$(type "${COMMAND}")"
+    INFO="${TYPE_INFO}"
   fi
   nvm_echo "${INFO}"
 }
